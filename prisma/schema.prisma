generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  HOST
  GUEST
  ADMIN
}

enum HostStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListingType {
  APARTMENT
  HOUSE
  VILLA
  CABIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model ListingPhoto {
  id         String   @id @default(uuid())
  url        String
  publicId   String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  @@index([listingId])
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String   @unique
  username  String   @unique
  phone     String
  role      Role     @default(GUEST)
  hostStatus HostStatus?
  avatar    String?
  avatarPublicId    String?
  bio       String?
  resetToken String?
  resetTokenExpiry DateTime?
  password  String   @default("123")
  updatedAt DateTime? @updatedAt
  createdAt DateTime @default(now())

  listings  Listing[]
  bookings  Booking[]
  notifications Notification[]
  @@index([name])
  @@index([role])
  reviews Review[]
}

model Listing {
  id            String         @id @default(uuid())
  title         String
  description   String
  location      String
  pricePerNight Float
  guests        Int
  type          ListingType
  amenities     String[]
  rating        Float?
  photos    ListingPhoto[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime? @updatedAt

  host     User @relation(fields: [hostId], references: [id], onDelete: Cascade)
  hostId   String

  bookings Booking[]
  @@index([hostId])
  @@index([location])
  @@index([type])
  @@index([pricePerNight])
  reviews Review[]
}

model Booking {
  id            String           @id @default(uuid())
  checkIn       DateTime
  checkOut      DateTime
  totalPrice    Float
  status        BookingStatus    @default(PENDING)
  paymentStatus PaymentStatus    @default(UNPAID)
  createdAt     DateTime         @default(now())

  guest     User    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  guestId   String

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  @@index([guestId])
  @@index([listingId])
  @@index([status])
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id])
  listing   Listing  @relation(fields: [listingId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([listingId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("BOOKING")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

